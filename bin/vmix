#!/bin/bash

TITLE="vmix"

DIRECTORY="/run/media/kevin/Storage/files/music/private/cutegeekie/mega"
PLAYLIST="$(mktemp /tmp/media-shuffle.XXXXXX.m3u)"

TRANSPOSE=2
FILECOUNT=50
ONCE=0

error_exit() {
    echo "Error: $1" >&2
    exit 1
}

declare -A OPTIONS=(
    [--directory]=DIRECTORY
    [-d]=DIRECTORY
    [--transpose]=TRANSPOSE
    [-t]=TRANSPOSE
    [--count]=FILECOUNT
    [-c]=FILECOUNT
    [--title]=TITLE
)


while [[ $# -gt 0 ]]; do
    option="$1"

    if [[ "$option" == "--once" ]]; then
        ONCE=1
        shift
        continue
    fi

    value="$2"

    [[ -n "${OPTIONS[$option]}" ]] || error_exit "Unknown option: $option"
    [[ -n "$value" ]] || error_exit "Missing value for $option"

    declare -n target="${OPTIONS[$option]}"
    target="$value"

    shift 2
done

if [[ "$TRANSPOSE" != "1" && "$TRANSPOSE" != "2" ]]; then
    error_exit "Invalid transpose value: '$TRANSPOSE'. Must be 1 or 2."
fi

[[ -d "$DIRECTORY" ]] ||
    error_exit "Directory does not exist: $DIRECTORY"

find -L "$(realpath "$DIRECTORY")" -maxdepth 3 -type f \( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.m4v' -o -iname '*.mkv' -o -iname '*.webm' -o -iname '*.avi' -o -iname '*.ts' \) | shuf -n "$FILECOUNT" > "$PLAYLIST"

[[ -s "$PLAYLIST" ]] || error_exit "No videos found"

# echo "Playing from directory: $(dirname "$(head -n1 "$PLAYLIST")")"

if [[ "$ONCE" == "1" ]]; then
    LOOP_OPTION="--no-loop-playlist"
else
    LOOP_OPTION="--loop-playlist"
fi

mpv \
    --title="$TITLE" \
    "$LOOP_OPTION" \
    --playlist="$PLAYLIST" \
    --video-zoom=0.25 \
    --script="$HOME/.config/mpv/manual_scripts/rotate_auto.lua" \
    --script-opts="rotate_auto-transpose=$TRANSPOSE" \
    &>/dev/null
