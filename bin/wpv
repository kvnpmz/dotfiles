#!/usr/bin/env lua

local CONTROL = "/home/kevin/bin/wpv_control.sh"

local function die(message)
    io.stderr:write("Error: " .. message .. "\n")
    os.exit(1)
end

local function shell_quote(value)
    return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
end

local function is_directory(path)
    local ok = os.execute(
        "test -d " .. shell_quote(path) .. " >/dev/null 2>&1"
    )

    return ok == true or ok == 0
end

local panes = os.getenv("PANES")
if panes == nil or panes == "" then
    panes = "3"
end

local transpose = os.getenv("TRANSPOSE")
if transpose == nil or transpose == "" then
    transpose = "2"
end

local sources = {}

local i = 1

while i <= #arg do
    local value = arg[i]

    if value == "-p" or value == "--panes" then
        if not arg[i + 1] then
            die(value .. " requires a value")
        end

        panes = arg[i + 1]
        i = i + 2

    elseif value == "-t" or value == "--transpose" then
        if not arg[i + 1] then
            die(value .. " requires a value")
        end

        transpose = arg[i + 1]
        i = i + 2

    elseif value == "--" then
        i = i + 1

        while i <= #arg do
            if #sources >= 4 then
                die("maximum 4 sources")
            end

            sources[#sources + 1] = arg[i]
            i = i + 1
        end

    else
        if #sources >= 4 then
            die("maximum 4 sources")
        end

        sources[#sources + 1] = value
        i = i + 1
    end
end

if panes ~= "3" and panes ~= "4" then
    die("panes must be 3 or 4 (got: " .. panes .. ")")
end

if transpose ~= "1" and transpose ~= "2" then
    die("transpose must be 1 or 2 (got: " .. transpose .. ")")
end

if panes == "3" and #sources > 3 then
    die("maximum 3 sources")
end

local left   = sources[1] or "."
local center = sources[2] or left
local right  = sources[3] or left
local fourth = sources[4] or left

local function viewer_command(title, source)

    if source:match("^https://") then
        local script =
            os.getenv("HOME")
            .. "/.config/mpv/manual_scripts/rotate_auto.lua"

        return table.concat({
            "mpv",
            "--title=" .. shell_quote(title),
            "--loop-file=inf",
            "--video-zoom=0.25",
            "--script=" .. shell_quote(script),
            "--script-opts="
                .. shell_quote("rotate_auto-transpose=" .. transpose),
            shell_quote(source),
        }, " ")
    end

    if source:match("^img:") then
        local directory = source:sub(5)

        if not is_directory(directory) then
            die("image directory does not exist: " .. directory)
        end

        return table.concat({
            "imix",
            "--title", shell_quote(title),
            "-d", shell_quote(directory),
            "--transpose", shell_quote(transpose),
        }, " ")
    end

    if source:match("^mix:") then
        local directory = source:sub(5)

        return table.concat({
            "mix",
            "--title", shell_quote(title),
            "-d", shell_quote(directory),
            "--transpose", shell_quote(transpose),
        }, " ")
    end

    if not is_directory(source) then
        die(
            "source must be a directory or https:// URL: "
            .. source
        )
    end

    return table.concat({
        "vmix",
        "--title", shell_quote(title),
        "-d", shell_quote(source),
        "--transpose", shell_quote(transpose),
    }, " ")
end

local commands = {
    viewer_command("wpv-left", left),
    viewer_command("wpv-center", center),
    viewer_command("wpv-right", right),
}

if panes == "4" then
    commands[#commands + 1] =
        viewer_command("wpv-fourth", fourth)
end

local command = shell_quote(CONTROL)

for _, viewer in ipairs(commands) do
    command = command .. " " .. shell_quote(viewer)
end

local ok, exit_type, exit_code = os.execute(command)

if ok == true or ok == 0 then
    os.exit(0)
end

if exit_type == "exit" and exit_code then
    os.exit(exit_code)
end

os.exit(1)

