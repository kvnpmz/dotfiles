#!/usr/bin/env lua

local handle = io.popen("find . -maxdepth 1 -type f -name 'diff_chunk_a*' -print | sort")

for filename in handle:lines() do
    print("Copying: " .. filename)

    os.execute("hcat " .. string.format("%q", filename) .. " | cpy")

    while true do
        io.write("Type 'y' to continue: ")
        io.flush()

        local input = io.read("*l")

        if input == "y" then
            break
        end
    end
end

handle:close()

print("Done.")

