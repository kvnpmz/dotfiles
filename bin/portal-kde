#!/bin/sh
# KDE portal backend with 1.5x UI scaling + Breeze Dark colour scheme.
# Activated by ~/.local/share/dbus-1/services/org.freedesktop.impl.portal.desktop.kde.service
export QT_SCALE_FACTOR=1.5
# Use the real KDE platform theme so kdeglobals ColorScheme=BreezeDark is honoured
export QT_QPA_PLATFORMTHEME=kde
exec /usr/libexec/xdg-desktop-portal-kde "$@"
