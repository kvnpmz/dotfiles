#!/usr/bin/env lua

local cities = {
    { "󰖟  FL", "America/New_York" },
    { "󰖟  TX", "America/Chicago" },
    { "󰖟  BA", "America/Argentina/Buenos_Aires" },
}

local state_file = "/tmp/worldclock_state"

local index = 0

local file = io.open(state_file, "r")
if file then
    index = tonumber(file:read("*l")) or 0
    file:close()
end

local city = cities[index + 1] or cities[1]
local city_name = city[1]
local timezone = city[2]

local command = string.format(
    "TZ='%s' date '+%%H:%%M:%%S|%s|%%A, %%d %%B %%Y'",
    timezone,
    city_name
)

local pipe = io.popen(command)
local output = pipe:read("*l")
pipe:close()

if output then
    print(output)
end

