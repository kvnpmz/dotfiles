#!/usr/bin/env lua

local home = os.getenv("HOME")
local fifo = "/tmp/creek_in"
local bar = home .. "/.config/creek/bar"
local contexts = { "browser", "terminal", "files", "general" }
package.path = package.path .. ";" .. home .. "/.config/creek/?.lua"
local actions = require("modules.actions")

os.remove(fifo)
os.execute("mkfifo " .. fifo)

local bar_pid = io.popen("sh -c '" .. bar .. " > " .. fifo .. " & echo $!'"):read("*l")

local function process_line(line)
    local index = tonumber(line:match("^click (%d+)$"))
    if index and contexts[index] then
        os.execute("argenctl context switch " .. contexts[index])
        return
    end

    local rune = line:match("^status (.+)$")
    if rune and actions.click[rune] then
        os.execute(actions.click[rune])
        return
    end

    local scroll_rune, direction = line:match("^scroll (.+):(.+)$")
    local scroll_key = scroll_rune and direction and (scroll_rune .. ":" .. direction)
    local scroll_cmd = scroll_key and actions.scroll[scroll_key]

    if scroll_cmd then
        os.execute(scroll_cmd)
    end
end

local creek = io.popen([[
    creek -hg 50 \
    -fn "Ubuntu Sans Mono:size=24:weight=bold" \
    -nf "0xffa500" \
    -nb "0x231f1d" \
    < ]] .. fifo .. [[ 2> /tmp/creek.log
]], "r")

for line in creek:lines() do
    process_line(line)
end

creek:close()

os.execute("kill " .. bar_pid .. " 2>/dev/null")
os.remove(fifo)

