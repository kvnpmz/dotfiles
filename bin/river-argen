#!/bin/sh

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

/usr/bin/pkill -9 -u "$USER" -f "Xwayland|sunshine|xdg-desktop|pipewire" 2>/dev/null
/usr/bin/rm -f "/run/user/$(id -u)"/wayland-* 2>/dev/null
/usr/bin/rm -f /tmp/argen_contexts

exec dbus-run-session river -c argen > /tmp/river-argen.log 2>&1

