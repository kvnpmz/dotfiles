#!/usr/bin/env luajit

io.stdout:setvbuf("no")

local home = os.getenv("HOME")
package.path = package.path .. ";" .. home .. "/.config/creek/?.lua"

local helper = require("helpers")
local tags = require("modules.tags")
local cpu = require("modules.cpu")
local memory = require("modules.memory")
local battery = require("modules.battery")
local time = require("modules.time")
local power = require("modules.power")
local network = require("modules.network")
local audio = require("modules.audio")
local brightness = require("modules.brightness")
local vpn = require("modules.vpn")
local keyboard = require("modules.keyboard")

os.setlocale("", "time")

local SPACER = "              "

local function nz(value)
    return value or ""
end

while true do
    local current_time = helper.now()

    local tags_line = tags.get()

    local cpu_usage = cpu.get(current_time)
    local mem_status = memory.get(current_time)
    local battery_str = battery.get(current_time)

    local world_time, date_str = time.update(current_time)

    local vpn_status = vpn.get(current_time)
    local network_str = network.get(current_time)
    local kb_layout = keyboard.get(current_time)

    local power_str = power.get()
    local volume_str = audio.volume()
    local brightness_str = brightness.get()

    io.write(tags_line .. "\n")

    local status_text = string.format("%s %s %s %s %s %s %s %s %s %s %s %s",
        nz(cpu_usage),
        nz(mem_status),
        nz(battery_str),
        nz(date_str),
        nz(world_time),
        SPACER,
        nz(power_str),
        nz(network_str),
        nz(volume_str),
        nz(brightness_str),
        nz(vpn_status),
        nz(kb_layout)
    )

    io.write(status_text .. "\n")
    io.flush()

    io.popen("sleep 0.05"):close()
end

